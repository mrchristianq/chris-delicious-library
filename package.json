{
  "name": "chris-delicious-library",
  "version": "10.2.18",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "dev:clean": "node scripts/dev-clean.mjs",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "dev:native": "NEXT_PUBLIC_NATIVE_APP=true npm run tauri dev",
    "build": "next build",
    "build:native-renderer": "node scripts/build-native-renderer.mjs",
    "build:native": "NEXT_PUBLIC_NATIVE_APP=true npm run tauri build",
    "tauri": "tauri",
    "build:pages": "node scripts/build-pages.mjs",
    "sync:pages-root": "node scripts/sync-pages-root.mjs",
    "publish:pages": "npm run build:pages && npm run sync:pages-root",
    "start": "next start",
    "lint": "eslint",
    "download-covers": "node scripts/download-covers.js",
    "download-from-manifest": "node scripts/download-from-manifest.js",
    "sync-covers": "node scripts/sync-new-covers.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@tauri-apps/api": "^2.11.0",
